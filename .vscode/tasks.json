{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "docker-compose",
        "type": "shell",
        "command": "docker",
        "args": [
            "compose",
            "-f",
            "docker/docker-compose.yml",
            "up",
            "-d",
            "--build"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    }
]
}