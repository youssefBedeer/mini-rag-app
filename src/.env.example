APP_NAME = "mini-RAG"
APP_VERSION = "0.1"
OPEN_API_KEY= ""

FILE_ALLOWED_TYPES = ["text/plain", "application/pdf"]
FILE_MAX_SIZE = 1 # MB
FILE_DEFAULT_CHUNK_SIZE = 512000 # 512KB

# DATABASE
MONGODB_URL= "mongodb://admin:admin@localhost:27007" 
MONGODB_DATABASE= "mini-rag"


# LLM CONFIG 
GENERATION_BACKEND = "OPENROUTER"
EMBEDDING_BACKEND = "OPENROUTER"

OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""
OPENROUTER_API_KEY= ""
HF_API_KEY= ""

GENERATION_MODEL_ID="gpt-3.5-turbo-0125"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

# VectorDB CONFIG
VECTOR_DB_BACKEND = "QDRANT"
VECTOR_DB_PATH= "qdrant_db"
VECTOR_DB_DISTANCE_METHOD= "cosine"

# 
WINDOWS_RESERVED = ["CON","PRN","AUX","NUL","COM1","COM2","COM3","COM4","COM5","COM6","COM7","COM8","COM9","LPT1","LPT2","LPT3","LPT4","LPT5","LPT6","LPT7","LPT8","LPT9"]